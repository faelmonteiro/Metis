OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# SEARXNG_URL é opcional. Se vazio, o Metis usa busca web nativa sem Docker (DuckDuckGo).
# SEARXNG_URL=http://127.0.0.1:8080

GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
G4F_MODEL=gpt-4o-mini

MAX_SEARCH_RESULTS=5
SEARCH_TIMEOUT=15
API_TIMEOUT=30
MAX_HISTORY_MESSAGES=20
MAX_WEB_CONTENT_CHARS=3000

OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.7
SEARXNG_STATUS_TTL=60
NO_COLOR=0

SYSTEM_PROMPT=
FETCH_PAGE_CONTENT=1
LOG_LEVEL=WARNING

# O Hyprland é detectado pela variável HYPRLAND_INSTANCE_SIGNATURE.
# Se estiver vazia ou ausente, a integração fica desativada.
HYPRLAND_INSTANCE_SIGNATURE=
