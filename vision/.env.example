# ==============================================================================
# ScreenAI • Arquivo de Configuração de Chaves e Modelos
# ==============================================================================

# Provedor preferido: nvidia | gemini | openrouter | ollama | groq
SCREENAI_PROVIDER=nvidia

# NVIDIA NIM API (Llama 3.2 Vision)
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Google Gemini API (Google AI Studio - começa com AIzaSy...)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Ollama Local
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision:11b
